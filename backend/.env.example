# Async SQLAlchemy connection string. In Compose the host is the `db` service name.
DATABASE_URL=postgresql+asyncpg://appuser:apppassword@db:5432/appdb

# Comma-separated list of origins allowed to call this API:
#   http://localhost:5173   the browser / Tauri dev server
#   tauri://localhost       the Tauri production webview on macOS and Linux
#   http://tauri.localhost  the Tauri production webview on Windows
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
